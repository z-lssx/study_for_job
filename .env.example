POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study_for_job
POSTGRES_DEV_DB=study_for_job_dev
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_SSLMODE=
# Optional compatibility override; when set, it takes precedence over POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://study:study@localhost:5432/study_for_job
CORS_ORIGINS=http://localhost:5173
APP_ENVIRONMENT=development
APP_DATABASE_NAME=study_for_job_dev

# AI Gateway defaults to the deterministic local provider. Real credentials stay in local environment only.
AI_PROVIDER=fake
AI_REQUEST_TIMEOUT_SECONDS=30
AI_FAKE_MODEL=local-deterministic-v1
# SophNet is the current DeepSeek/OpenAI-compatible endpoint. Keep real keys in local environment only.
# AI_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://www.sophnet.com/api/open-apis/v1
# DEEPSEEK_MODEL=
# SOPHNET_API_KEY=
# Optional explicit override; when present, it takes precedence over SOPHNET_API_KEY.
# DEEPSEEK_API_KEY=

# Optional Docker build proxy. Use host.docker.internal when a host proxy is bound to localhost.
# DOCKER_BUILD_HTTP_PROXY=http://host.docker.internal:7897
# DOCKER_BUILD_HTTPS_PROXY=http://host.docker.internal:7897
# DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1,::1
